[Unit]
Description=Private WhatsApp Secretary setup
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/build-sprint-app
Environment=HOME=/home/ubuntu
Environment=NODE_ENV=production
Environment=HELPER_HERMES_PYTHON=/home/ubuntu/.hermes/hermes-agent/.venv/bin/python
Environment=PYTHONPATH=/home/ubuntu/.hermes/hermes-agent
ExecStart=/usr/bin/flock -n /home/ubuntu/.hermes/the-helper/secretary-setup.lock /usr/local/bin/node scripts/run-secretary-setup.mjs
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
