[Unit]
Description=WhatsApp role-board helper (Test_group pilot)
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/build-sprint-app
Environment=NODE_ENV=production
Environment=HOME=/home/ubuntu
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HELPER_HERMES_PYTHON=/home/ubuntu/.hermes/hermes-agent/.venv/bin/python
Environment=PYTHONPATH=/home/ubuntu/.hermes/hermes-agent
ExecStart=/usr/local/bin/node scripts/run-milestone-6.mjs --weekly
Restart=on-failure
RestartSec=15
TimeoutStopSec=90
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
